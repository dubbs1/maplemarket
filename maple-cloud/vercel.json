{
  "rewrites": [
    { "source": "/api/:route", "destination": "/api/market?route=:route" },
    { "source": "/icons/:file", "destination": "/api/market?route=iconfile&file=:file" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
